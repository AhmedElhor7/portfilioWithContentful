# Copy this file to `.env.local` and fill in the values.
# Never commit real credentials.

# --- Contentful (server only) ---
# Space ID and Delivery API access token for the published content.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
# Optional. Defaults to `master`.
CONTENTFUL_ENVIRONMENT=master

# --- Portfolio assistant (server only) ---
# Google AI Studio key used by the chat API route.
GEMINI_API_KEY=
# Optional. Defaults to `gemini-3.5-flash`.
GEMINI_MODEL=gemini-3.5-flash

# --- Contentful webhook (optional) ---
# Shared secret sent in the `x-revalidate-secret` header by the Contentful
# webhook that calls `/api/revalidate`. Leave empty to disable on-demand
# revalidation; the 5-minute ISR window still applies.
CONTENTFUL_REVALIDATE_SECRET=

# --- Public site metadata ---
# Absolute production URL, for example `https://example.com`.
# Leave empty locally to avoid publishing a placeholder canonical URL.
NEXT_PUBLIC_SITE_URL=

# --- Optional outbound proxy ---
# Only used for the Gemini request. Leave empty unless your network requires it.
HTTPS_PROXY=
HTTP_PROXY=
